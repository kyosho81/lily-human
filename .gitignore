# Runtime output: logs, pid files, generated/test audio
# =============================================================================
*.log
*.log.*
*.pid
*.wav

# Machine-local / secret material - never publish
/services/web-patches/config-restore.js
/claude-bridge/config.json
/.mcp.json
/logs/

